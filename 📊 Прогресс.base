filters:
  and:
    - file.hasTag("cpp/урок")
properties:
  note.lesson:
    displayName: Урок
  note.module:
    displayName: Модуль
  note.done:
    displayName: Пройден
views:
  - type: table
    name: Все уроки
    groupBy:
      property: module
      direction: ASC
    order:
      - lesson
      - file.name
      - done
    sort:
      - property: lesson
        direction: ASC
  - type: table
    name: Осталось пройти
    filters:
      and:
        - note.done != true
    order:
      - lesson
      - file.name
    sort:
      - property: lesson
        direction: ASC
